[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/data/dialogue_line.gd" id="2_line"]
[ext_resource type="Resource" path="res://data/defenders/usb.tres" id="3_usb"]
[ext_resource type="Resource" path="res://data/enemies/bibliografia.tres" id="4_bibliografia"]

[sub_resource type="Resource" id="Resource_line1"]
script = ExtResource("2_line")
expression = "feliz"
text = "Para empezar, te doy el USB: barato, rápido de recargar y siempre se pierde."
show_card = ExtResource("3_usb")

[sub_resource type="Resource" id="Resource_line2"]
script = ExtResource("2_line")
text = "No aguanta tanto como el Firewall, pero sale en cualquier apuro."

[sub_resource type="Resource" id="Resource_line3"]
script = ExtResource("2_line")
expression = "sorprendido"
text = "¡Ahí está! La Bibliografía: carga una pila de libros que absorbe el daño."
show_enemy = ExtResource("4_bibliografia")

[sub_resource type="Resource" id="Resource_line4"]
script = ExtResource("2_line")
expression = "serio"
text = "Cuando se le caen los libros, todavía queda alguien debajo. No bajes la guardia."

[resource]
script = ExtResource("1_data")
id = "w2_l1_intro"
lines = Array[ExtResource("2_line")]([SubResource("Resource_line1"), SubResource("Resource_line2"), SubResource("Resource_line3"), SubResource("Resource_line4")])
