[gd_resource type="Resource" script_class="DialogueData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/data/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="Resource_line1"]
script = ExtResource("2_line")
expression = "orgulloso"
text = "¡Sobreviviste a tu primer día! Y sin derramar mi café. Vas bien."

[sub_resource type="Resource" id="Resource_line2"]
script = ExtResource("2_line")
text = "Cada nivel que ganas te deja una calificación en el sello. Si lo repites y lo haces mejor, se guarda la mejor."

[sub_resource type="Resource" id="Resource_line3"]
script = ExtResource("2_line")
expression = "sorprendido"
text = "Aunque… nunca había visto tantas tareas despiertas el primer día. Algo las está apurando."

[sub_resource type="Resource" id="Resource_line4"]
script = ExtResource("2_line")
expression = "serio"
text = "Mañana empieza el semestre en serio. Ahí ya no te voy a llevar de la mano."

[resource]
script = ExtResource("1_data")
id = "w1_l1_outro"
lines = Array[ExtResource("2_line")]([SubResource("Resource_line1"), SubResource("Resource_line2"), SubResource("Resource_line3"), SubResource("Resource_line4")])
