[gd_resource type="Resource" script_class="DialogueData" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/data/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="Resource_line1"]
script = ExtResource("2_line")
expression = "feliz"
text = "¡Bienvenido a la ESCOM, nuevo ingreso! Soy Her Mosso, tu Director, y voy a acompañarte toda la carrera."

[sub_resource type="Resource" id="Resource_line2"]
script = ExtResource("2_line")
expression = "serio"
text = "Te voy a contar algo que no viene en la guía de inscripción: en el sótano hay un lugar llamado el Archivo Muerto."

[sub_resource type="Resource" id="Resource_line3"]
script = ExtResource("2_line")
expression = "preocupado"
text = "Ahí terminan las tareas que nadie entregó. Y cada semestre… despiertan y marchan hacia los salones."

[sub_resource type="Resource" id="Resource_line4"]
script = ExtResource("2_line")
text = "Tu misión: llegar a titularte sin que ninguna te alcance. Ocho semestres. Fácil, ¿no?"

[sub_resource type="Resource" id="Resource_line5"]
script = ExtResource("2_line")
expression = "feliz"
text = "Empieza por «Primer día». Yo te enseño lo básico… y hasta te presto mi café."

[resource]
script = ExtResource("1_data")
id = "w1_intro"
lines = Array[ExtResource("2_line")]([SubResource("Resource_line1"), SubResource("Resource_line2"), SubResource("Resource_line3"), SubResource("Resource_line4"), SubResource("Resource_line5")])
